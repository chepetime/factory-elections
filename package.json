{
  "name": "factory-elections",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "factory": "./bin/factory"
  },
  "scripts": {
    "factory": "node apps/cli/src/main.ts",
    "test": "node --test --test-reporter=spec \"packages/*/test/**/*.test.ts\" \"apps/cli/test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "oxlint --deny-warnings .",
    "format": "prettier --write .",
    "format:check": "prettier --list-different --ignore-unknown .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.323",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
