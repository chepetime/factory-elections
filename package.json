{
  "name": "factory-elections",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "factory": "./bin/factory"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "factory": "node apps/cli/src/main.ts",
    "test": "node --test --test-timeout=120000 --test-reporter=spec \"packages/*/test/**/*.test.ts\" \"apps/cli/test/**/*.test.ts\" \"tests/repo/**/*.test.ts\" && pnpm --filter @factory/web test",
    "typecheck": "tsc --noEmit --pretty false && pnpm --filter @factory/web typecheck && pnpm --filter @factory/docs typecheck",
    "lint": "oxlint --deny-warnings . && node scripts/unused-files.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --list-different --ignore-unknown .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm --filter @factory/web build",
    "start": "node scripts/start.mjs",
    "web": "node scripts/web.mjs",
    "restart": "node scripts/restart.mjs",
    "shot": "node scripts/shot.mjs",
    "storybook": "pnpm --filter @factory/web storybook",
    "storybook:build": "pnpm --filter @factory/web storybook:build",
    "storybook:test": "pnpm --filter @factory/web storybook:test",
    "docs": "pnpm --filter @factory/docs dev",
    "docs:build": "pnpm --filter @factory/docs build",
    "backend": "node apps/backend/src/main.ts",
    "rpc:generate": "node scripts/generate-rpc.mjs",
    "data:up": "node scripts/data.mjs up",
    "data:down": "node scripts/data.mjs down",
    "data:status": "node scripts/data.mjs status",
    "data:migrate": "node scripts/data.mjs migrate",
    "data:test": "node scripts/data.mjs test",
    "e2e": "node --test --test-concurrency=1 \"apps/web/e2e/*.e2e.ts\"",
    "worktree": "node scripts/worktree.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "ci:plan": "node scripts/ci-plan.mjs",
    "ci:affected": "node scripts/ci-run.mjs",
    "harness:stats": "node scripts/harness-stats.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.323",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "effect": "^4.1.6",
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
