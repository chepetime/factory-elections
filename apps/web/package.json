{
  "name": "@factory/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @factory/affect-ui build && next dev --webpack --hostname localhost",
    "build": "pnpm --filter @factory/affect-ui build && next build --webpack",
    "start": "next start --hostname localhost",
    "typecheck": "pnpm --filter @factory/affect-ui build && tsc --noEmit --pretty false",
    "test": "pnpm --filter @factory/affect-ui build && vitest run --project unit",
    "storybook": "pnpm --filter @factory/affect-ui build && storybook dev --host 127.0.0.1 -p 6006 --no-open --disable-telemetry",
    "storybook:build": "pnpm --filter @factory/affect-ui build && storybook build --disable-telemetry",
    "storybook:test": "pnpm --filter @factory/affect-ui build && vitest run --project storybook-light --project storybook-dark"
  },
  "devDependencies": {
    "@factory/backend": "workspace:*",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "playwright": "^1.65.0",
    "storybook": "10.6.7",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.187",
    "@base-ui/react": "^1.9.0",
    "@factory/affect-ui": "workspace:*",
    "@factory/backend-client": "workspace:*",
    "@factory/core": "workspace:*",
    "@factory/ui": "workspace:*",
    "ai": "7.0.182",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.72.0",
    "motion": "^14.13.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  }
}
