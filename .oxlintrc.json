{
  "ignorePatterns": [
    "plain_modules/**",
    "dist/**",
    "apps/web/.next/**",
    "packages/affect-ui/upstream/**",
    "packages/affect-ui/dist/**",
    "apps/web/storybook-static/**",
    "apps/web/test-results/**"
  ],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["node:*", "@anthropic-ai/*", "@factory/adapters-*", "@factory/driver"],
            "message": "packages/core must stay pure"
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "packages/adapters-*/**",
        "packages/driver/**",
        "packages/backend/**",
        "apps/**",
        "packages/*/test/**",
        "scripts/**"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
