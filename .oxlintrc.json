{
  "ignorePatterns": [
    "plain_modules/**",
    "dist/**",
    "apps/web/.next/**",
    "packages/affect-ui/upstream/**",
    "packages/affect-ui/dist/**",
    "apps/web/storybook-static/**",
    "apps/web/test-results/**",
    "apps/docs/.next/**",
    "apps/docs/.source/**"
  ],
  "rules": {},
  "overrides": [
    {
      "files": ["packages/core/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*", "@anthropic-ai/*", "@factory/**"],
                "message": "ADR 0006: packages/core must stay pure: it imports no other workspace package"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/backend-client/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@factory/**", "!@factory/core", "!@factory/core/**"],
                "message": "ADR 0006: backend-client may import only core"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/dispatcher/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "node:fs",
                  "node:fs/*",
                  "node:child_process",
                  "@factory/**",
                  "!@factory/core",
                  "!@factory/core/**"
                ],
                "message": "ADR 0006: packages/dispatcher only schedules and may import only core: the backend passes each job's work in"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/evidence/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@factory/**",
                  "!@factory/core",
                  "!@factory/core/**",
                  "!@factory/adapters-data",
                  "!@factory/adapters-data/**"
                ],
                "message": "ADR 0006: packages/evidence may import only core and adapters-data: take anything else as a port"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/compose/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@factory/**",
                  "!@factory/core",
                  "!@factory/core/**",
                  "!@factory/driver",
                  "!@factory/driver/**",
                  "!@factory/adapters-claude",
                  "!@factory/adapters-claude/**",
                  "!@factory/adapters-codex",
                  "!@factory/adapters-codex/**",
                  "!@factory/adapters-data",
                  "!@factory/adapters-data/**",
                  "!@factory/adapters-fs",
                  "!@factory/adapters-fs/**",
                  "!@factory/adapters-git",
                  "!@factory/adapters-git/**",
                  "!@factory/adapters-github",
                  "!@factory/adapters-github/**",
                  "!@factory/adapters-process",
                  "!@factory/adapters-process/**"
                ],
                "message": "ADR 0006: packages/compose may import only core, driver and adapters"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/pr-reviews/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@factory/**",
                  "!@factory/core",
                  "!@factory/core/**",
                  "!@factory/dispatcher",
                  "!@factory/dispatcher/**",
                  "!@factory/evidence",
                  "!@factory/evidence/**",
                  "!@factory/adapters-claude",
                  "!@factory/adapters-claude/**",
                  "!@factory/adapters-codex",
                  "!@factory/adapters-codex/**",
                  "!@factory/adapters-data",
                  "!@factory/adapters-data/**",
                  "!@factory/adapters-fs",
                  "!@factory/adapters-fs/**",
                  "!@factory/adapters-git",
                  "!@factory/adapters-git/**",
                  "!@factory/adapters-github",
                  "!@factory/adapters-github/**",
                  "!@factory/adapters-process",
                  "!@factory/adapters-process/**"
                ],
                "message": "ADR 0006: packages/pr-reviews may import only core, dispatcher, evidence and adapters: take the backend as a port"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/agents/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@factory/**",
                  "!@factory/core",
                  "!@factory/core/**",
                  "!@factory/driver",
                  "!@factory/driver/**",
                  "!@factory/dispatcher",
                  "!@factory/dispatcher/**",
                  "!@factory/adapters-claude",
                  "!@factory/adapters-claude/**",
                  "!@factory/adapters-codex",
                  "!@factory/adapters-codex/**",
                  "!@factory/adapters-data",
                  "!@factory/adapters-data/**",
                  "!@factory/adapters-fs",
                  "!@factory/adapters-fs/**",
                  "!@factory/adapters-git",
                  "!@factory/adapters-git/**",
                  "!@factory/adapters-github",
                  "!@factory/adapters-github/**",
                  "!@factory/adapters-process",
                  "!@factory/adapters-process/**"
                ],
                "message": "ADR 0006: packages/agents may import only core, driver, dispatcher and adapters: use the AgentBoard port for the backend"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/backend/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@factory/**",
                  "!@factory/core",
                  "!@factory/core/**",
                  "!@factory/backend-client",
                  "!@factory/backend-client/**",
                  "!@factory/dispatcher",
                  "!@factory/dispatcher/**",
                  "!@factory/evidence",
                  "!@factory/evidence/**",
                  "!@factory/compose",
                  "!@factory/compose/**",
                  "!@factory/pr-reviews",
                  "!@factory/pr-reviews/**",
                  "!@factory/agents",
                  "!@factory/agents/**",
                  "!@factory/driver",
                  "!@factory/driver/**",
                  "!@factory/adapters-claude",
                  "!@factory/adapters-claude/**",
                  "!@factory/adapters-codex",
                  "!@factory/adapters-codex/**",
                  "!@factory/adapters-data",
                  "!@factory/adapters-data/**",
                  "!@factory/adapters-fs",
                  "!@factory/adapters-fs/**",
                  "!@factory/adapters-git",
                  "!@factory/adapters-git/**",
                  "!@factory/adapters-github",
                  "!@factory/adapters-github/**",
                  "!@factory/adapters-process",
                  "!@factory/adapters-process/**"
                ],
                "message": "ADR 0006: the backend composes the packages below it and never imports an app"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/adapters-claude/src/**",
        "packages/adapters-fs/src/**",
        "packages/adapters-process/src/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@factory/**", "!@factory/core", "!@factory/core/**"],
                "message": "ADR 0006: this adapter imports only core"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/adapters-git/src/**",
        "packages/adapters-github/src/**",
        "packages/adapters-codex/src/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@factory/**",
                  "!@factory/core",
                  "!@factory/core/**",
                  "!@factory/adapters-process",
                  "!@factory/adapters-process/**"
                ],
                "message": "ADR 0006: this adapter may import only core and adapters-process"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/adapters-data/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@factory/**",
                  "!@factory/core",
                  "!@factory/core/**",
                  "!@factory/adapters-fs",
                  "!@factory/adapters-fs/**"
                ],
                "message": "ADR 0006: adapters-data may import only core and adapters-fs"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/driver/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@factory/**", "!@factory/core", "!@factory/core/**"],
                "message": "ADR 0006: the driver imports only core; adapters come in through ports"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@factory/**",
                  "!@factory/core",
                  "!@factory/core/**",
                  "!@factory/backend-client",
                  "!@factory/backend-client/**",
                  "!@factory/affect-ui",
                  "!@factory/affect-ui/**"
                ],
                "message": "ADR 0006: apps/web talks to the backend only through @factory/backend-client"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/cli/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@factory/**",
                  "!@factory/core",
                  "!@factory/core/**",
                  "!@factory/backend",
                  "!@factory/backend/**",
                  "!@factory/backend-client",
                  "!@factory/backend-client/**",
                  "!@factory/driver",
                  "!@factory/driver/**",
                  "!@factory/compose",
                  "!@factory/compose/**",
                  "!@factory/evidence",
                  "!@factory/evidence/**",
                  "!@factory/adapters-claude",
                  "!@factory/adapters-claude/**",
                  "!@factory/adapters-codex",
                  "!@factory/adapters-codex/**",
                  "!@factory/adapters-data",
                  "!@factory/adapters-data/**",
                  "!@factory/adapters-fs",
                  "!@factory/adapters-fs/**",
                  "!@factory/adapters-git",
                  "!@factory/adapters-git/**",
                  "!@factory/adapters-github",
                  "!@factory/adapters-github/**",
                  "!@factory/adapters-process",
                  "!@factory/adapters-process/**"
                ],
                "message": "ADR 0006: apps/cli may import only core, driver, compose, evidence, backend, backend-client and adapters"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/backend/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@factory/**",
                  "!@factory/backend",
                  "!@factory/backend/**",
                  "!@factory/adapters-fs",
                  "!@factory/adapters-fs/**"
                ],
                "message": "ADR 0006: apps/backend starts the backend and may import only backend and adapters-fs"
              }
            ]
          }
        ]
      }
    }
  ]
}
