{
  "ignorePatterns": [
    "plain_modules/**",
    "dist/**",
    "apps/web/.next/**",
    "packages/affect-ui/upstream/**",
    "packages/affect-ui/dist/**",
    "apps/web/storybook-static/**",
    "apps/web/test-results/**",
    "apps/docs/.next/**",
    "apps/docs/.source/**"
  ],
  "rules": {},
  "overrides": [
    {
      "files": ["packages/core/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*", "@anthropic-ai/*", "@factory/adapters-*", "@factory/driver"],
                "message": "packages/core must stay pure"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@factory/backend", "@factory/backend/*", "@factory/driver", "@factory/adapters-*"],
                "message": "apps/web talks to the backend only through @factory/backend-client"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/dispatcher/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "node:fs",
                  "node:fs/*",
                  "node:child_process",
                  "@factory/adapters-*",
                  "@factory/driver",
                  "@factory/backend",
                  "@factory/backend/*"
                ],
                "message": "packages/dispatcher only schedules: the backend passes each job's work in"
              }
            ]
          }
        ]
      }
    }
  ]
}
